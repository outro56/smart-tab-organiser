{
  "manifest_version": 3,
  "name": "Smart Tab Organiser",
  "version": "1.3.6",
  "description": "Organize tabs with AI, tidy pinned tabs, and group GitHub, GitLab, or Azure DevOps code reviews.",
  "author": "Chibuike Muoh",
  "homepage_url": "https://github.com/outro56/smart-tab-organiser",
  "permissions": [
    "tabs",
    "storage",
    "tabGroups",
    "notifications",
    "contextMenus",
    "alarms"
  ],
  "host_permissions": [
    "https://api.openai.com/*",
    "https://api.anthropic.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.github.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Tidy pinned tabs (left-click)"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "organize-tabs": {
      "description": "Organize tabs with AI"
    }
  }
}
